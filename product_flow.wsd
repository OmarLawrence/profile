@startuml
actor User as User
participant "Front End" as FE
participant "Back End" as BE
participant "Score" as SC
participant "Spaaza" as SP
User -> FE: Login to app and create a basket
FE -> BE: product list request
BE -> SC: product price request
SC -> SP: product reqards and discounts
SP -> SC: <i>if yes: return rewards and discounts</i>
SP --> SC: <i>if no: return no rewards and discounts</i>
SC -> BE: return product prices (with rewards and discounts)
BE -> FE: return product list (with prices)
FE -> User: display product list
FE -> BE
BE -> SC
SC -> SP
SP -> SC
SC -> BE
BE -> FE
FE -> BE
BE -> SC
SC -> SP
SP -> SC
SC -> BE
BE -> FE
FE -> BE
BE -> SC
SC -> SP
SP -> SC
SC -> BE
BE -> FE
FE -> User: Basket closed
@enduml
